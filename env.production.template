# Pulsai Production Environment Configuration
# Copy this file to .env.production and fill in your values

# ============================================
# Application Settings
# ============================================
ENV=production
PULSAI_PORT=3000
PULSAI_API_PORT=8080
PULSAI_MCP_PORT=8100

# Public base URL of the Pulsai UI (used for OAuth redirects)
# Example (monolith compose): http://localhost:3000
# Example (backend-only compose): http://localhost:8080
WEBUI_URL=

# Backend replicas (horizontal scaling)
PULSAI_BACKEND_REPLICAS=2

# ============================================
# Security
# ============================================
# IMPORTANT: Generate a strong secret key
# Example: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production

# MCP Authentication Token
MCP_AUTH_TOKEN=your-mcp-auth-token-change-this

# ============================================
# Database Configuration
# ============================================
POSTGRES_DB=pulsai
POSTGRES_USER=pulsai
POSTGRES_PASSWORD=your-strong-postgres-password
POSTGRES_PORT=5432

# ============================================
# Redis Configuration
# ============================================
REDIS_PORT=6379

# ============================================
# Ollama Configuration
# ============================================
OLLAMA_PORT=11434

# ============================================
# vLLM Configuration (Optional)
# ============================================
VLLM_ENABLED=false
VLLM_BASE_URL=
VLLM_API_KEY=

# ============================================
# External AI APIs (Optional)
# ============================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ============================================
# n8n Workflow Automation (Optional)
# ============================================
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=

# ============================================
# Feature Flags
# ============================================
ENABLE_SIGNUP=true
ENABLE_WEBHOOKS=true
DEBUG=false

# ============================================
# OAuth / OIDC (choose ONE provider or use generic OIDC)
# ============================================

# --- Generic OIDC (Keycloak/Okta/Auth0/Azure Entra ID, etc.) ---
# Set your provider discovery URL and client credentials
# Example (Keycloak): https://keycloak.example.com/realms/myrealm/.well-known/openid-configuration
OPENID_PROVIDER_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SCOPES=openid email profile
OAUTH_PROVIDER_NAME=SSO
# Optional: restrict allowed email domains (comma-separated). Use * to allow all
OAUTH_ALLOWED_DOMAINS=*
# Optional: allow signup through OAuth if the user doesn't exist yet
ENABLE_OAUTH_SIGNUP=true
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=false

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPE=openid email profile

# --- Microsoft OAuth (optional) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CLIENT_TENANT_ID=
MICROSOFT_OAUTH_SCOPE=openid email profile

# --- GitHub OAuth (optional) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CLIENT_SCOPE=user:email

# Cookie settings for local (HTTP) Docker usage
WEBUI_AUTH_COOKIE_SAME_SITE=lax
WEBUI_AUTH_COOKIE_SECURE=false

