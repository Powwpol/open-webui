services:
  python-backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    restart: unless-stopped
    init: true
    ports:
      - "8080:8080"  # Exposed by backend Dockerfile
    # env_file: ./backend/.env  # Uncomment if .env file exists
    depends_on:
      - redis
      - postgres
    networks:
      - webui-net

  typescript-src:
    build:
      context: ./src
      dockerfile: Dockerfile
    restart: unless-stopped
    init: true
    ports:
      - "3000:3000"  # Exposed by src Dockerfile (SvelteKit preview)
    # env_file: ./src/.env  # Uncomment if .env file exists
    networks:
      - webui-net
    depends_on:
      - python-backend

  redis:
    image: redis:latest
    restart: unless-stopped
    networks:
      - webui-net
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    # Uncomment below to persist Redis data
    # volumes:
    #   - redis-data:/data

  postgres:
    image: postgres:latest
    restart: unless-stopped
    environment:
      POSTGRES_USER: webui
      POSTGRES_PASSWORD: webui
      POSTGRES_DB: webui
    networks:
      - webui-net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U webui"]
      interval: 10s
      timeout: 5s
      retries: 5
    # Uncomment below to persist Postgres data
    # volumes:
    #   - postgres-data:/var/lib/postgresql/data

networks:
  webui-net:
    driver: bridge

# Uncomment below if you want persistent data for Redis/Postgres
#volumes:
#  redis-data:
#  postgres-data:
